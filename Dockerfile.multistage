# ============================================================================
# MULTI-STAGE DOCKERFILE FOR MICAPIPE
# Stage 1: Build mamba environments (reusable, cacheable)
# Stage 2: Final image with system tools + pre-built environments
# ============================================================================

# ============================================================================
# STAGE 1: MAMBA ENVIRONMENT BUILDER
# ============================================================================
FROM ubuntu:bionic-20201119 AS mamba-env-builder

USER root
ARG DEBIAN_FRONTEND="noninteractive"

# Basic system packages needed for conda/mamba
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda
ARG DOWNLOADS_DIR="/downloads"
COPY . /tmp/build_context/
RUN mkdir -p /downloads && \
    if [ -f "/tmp/build_context/Miniconda3-latest-Linux-x86_64.sh" ]; then \
        echo "✅ Using pre-downloaded Miniconda installer"; \
        cp /tmp/build_context/Miniconda3-latest-Linux-x86_64.sh /downloads/Miniconda3-latest-Linux-x86_64.sh; \
    else \
        echo "📥 Downloading Miniconda installer..."; \
        wget -q --retry-connrefused --waitretry=5 --read-timeout=20 --timeout=15 -O /downloads/Miniconda3-latest-Linux-x86_64.sh \
            https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh; \
    fi

# Install conda and mamba with optimized settings
ENV PATH="/opt/miniconda-latest/bin:$PATH"
ENV MAMBA_NO_LOCK=1
ENV CONDA_PKGS_DIRS="/opt/miniconda-latest/pkgs"
RUN bash /downloads/Miniconda3-latest-Linux-x86_64.sh -b -p /opt/miniconda-latest \
    && . /opt/miniconda-latest/etc/profile.d/conda.sh \
    && conda config --set auto_update_conda false \
    && conda config --set show_channel_urls true \
    && conda config --set solver libmamba \
    && conda config --set channel_priority strict \
    && conda install -y -n base -c conda-forge mamba

# Create micapipe environment with all packages in optimal batches
RUN . /opt/miniconda-latest/etc/profile.d/conda.sh \
    && conda create -y -n micapipe python=3.9 \
    && echo "🔧 Installing core scientific packages..." \
    && mamba install -y -n micapipe -c conda-forge \
        --override-channels --strict-channel-priority \
        --threads 8 --retry-delay 5 --retry-attempts 3 \
        numpy scipy pandas matplotlib seaborn plotly \
        nibabel scikit-learn scikit-image \
        dipy==1.4.1 fury==0.8.0 \
        ipython jupyter tqdm joblib \
        h5py hdf5 pytables \
    && echo "🔧 Installing antspy and MRtrix3..." \
    && mamba install -y -n micapipe -c conda-forge -c mrtrix3 \
        --override-channels --strict-channel-priority \
        --threads 8 --retry-delay 5 --retry-attempts 3 \
        antspy mrtrix3==3.0.7 \
    && echo "🔧 Installing utilities and networking packages..." \
    && mamba install -y -n micapipe -c conda-forge \
        --override-channels --strict-channel-priority \
        --threads 8 --retry-delay 5 --retry-attempts 3 \
        bzip2 ca-certificates curl git openssh \
        unzip wget xz zip \
        cryptography paramiko pycryptodome \
        requests urllib3 \
        cmake make \
        gcc_linux-64 gxx_linux-64

# Create designer environment
RUN . /opt/miniconda-latest/etc/profile.d/conda.sh \
    && conda create -y -n designer python=3.8 \
    && mamba install -y -n designer -c conda-forge \
        --threads 8 --retry-delay 5 --retry-attempts 3 \
        numpy scipy matplotlib nibabel dipy

# Clean up conda/mamba caches to reduce image size
RUN conda clean -ya \
    && find /opt/miniconda-latest -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# ============================================================================
# STAGE 2: FINAL IMAGE WITH SYSTEM TOOLS
# ============================================================================
FROM ubuntu:bionic-20201119

USER root
ARG DEBIAN_FRONTEND="noninteractive"
ENV APT_LISTCHANGES_FRONTEND=none
ENV APT_OPTIONS="-o APT::Install-Suggests=false -o APT::Install-Recommends=false"

# CUDA build argument - defaults to false to preserve current behavior
ARG ENABLE_CUDA=false
ARG MICAPIPE_CACHE_DIR=""
ARG DOWNLOADS_DIR="/downloads"
ARG CUSTOM_TMPDIR="/host/cassio/export03/data/enning"

# Copy the pre-built conda environments from the builder stage
COPY --from=mamba-env-builder /opt/miniconda-latest /opt/miniconda-latest

# Copy downloaded dependencies if available
COPY . /tmp/build_context/
RUN mkdir -p /downloads && \
    echo "Copying pre-downloaded files if available..." && \
    if [ -f "/tmp/build_context/fsl-6.0.2-centos6_64.tar.gz" ]; then \
        echo "✅ Copying FSL..."; \
        cp /tmp/build_context/fsl-6.0.2-centos6_64.tar.gz /downloads/; \
    else \
        echo "⚠️  FSL not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz" ]; then \
        echo "✅ Copying FreeSurfer..."; \
        cp /tmp/build_context/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz /downloads/; \
    else \
        echo "⚠️  FreeSurfer not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/linux_openmp_64.tgz" ]; then \
        echo "✅ Copying AFNI..."; \
        cp /tmp/build_context/linux_openmp_64.tgz /downloads/; \
    else \
        echo "⚠️  AFNI not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/fix.tar.gz" ]; then \
        echo "✅ Copying FSL FIX..."; \
        cp /tmp/build_context/fix.tar.gz /downloads/; \
    else \
        echo "⚠️  FSL FIX not found, will download during build"; \
    fi && \
    rm -rf /tmp/build_context

# Install system packages in optimized chunks
RUN echo "Installing essential system packages (chunk 1/4)..." && \
    apt-get update && apt-get install -y --no-install-recommends \
        apt-utils \
        build-essential \
        ca-certificates \
        curl \
        gnupg \
        lsb-release \
        software-properties-common \
        wget \
    && echo "Installing development tools (chunk 2/4)..." && \
    apt-get install -y --no-install-recommends \
        cmake \
        git \
        make \
        pkg-config \
        unzip \
        zip \
    && echo "Installing graphics and multimedia libraries (chunk 3/4)..." && \
    apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libgomp1 \
        libglu1-mesa \
        libgtk-3-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxt6 \
        x11-apps \
        xvfb \
    && echo "Installing Python and scientific computing dependencies (chunk 4/4)..." && \
    apt-get install -y --no-install-recommends \
        bc \
        dc \
        file \
        libgfortran3 \
        liblapack3 \
        libopenblas-base \
        libquadmath0 \
        python3 \
        python3-pip \
        tcsh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up conda environment
ENV PATH="/opt/miniconda-latest/bin:$PATH"
RUN echo ". /opt/miniconda-latest/etc/profile.d/conda.sh" >> ~/.bashrc

# Install FSL (rest of the Dockerfile continues as before...)
# [Include all the existing FSL, FreeSurfer, AFNI, ANTs installations here]

# The key advantage: mamba environments are pre-built and cached!
# No more waiting for package resolution and downloads during the main build.