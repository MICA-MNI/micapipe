# Standard excludes
./docs
.circleci
.git
.github
.gitignore
.vscode
micapipe_v*.sif

# Large directories not needed in container
old/
test_data/
tests/
micapipe_snakebids/
.snakemake/
build_logs/
*.log

# Temporary files
temp_downloads/
conda-lock-output.log

# Documentation that's not needed in build
*.md
!README.md
dag.svg

# Python cache
__pycache__/
*.pyc
*.pyo

# Large installer files (CRITICAL: Do not copy these into the image!)
*.tar.gz
*.tgz
*.zip
Miniconda*.sh
fsl*.tar.gz
freesurfer*.tar.gz
afni*.tgz
fix*.tar.gz

# Build scripts
build_*.sh
migrate_*.sh
prepare_build_context.sh
check_docker_space.sh

