# Standard excludes
./docs
.circleci
.git
.github
.gitignore
.vscode
micapipe_v*.sif

# Large pre-downloaded tarballs - DO NOT send to Docker daemon
# These should be downloaded during build, not copied
*.tar.gz
*.tgz
Miniconda3-*.sh

# Large directories not needed in container
old/
test_data/
tests/
micapipe_snakebids/
.snakemake/
build_logs/
*.log

# Temporary files
temp_downloads/
conda-lock-output.log

# Documentation that's not needed in build
*.md
!README.md
dag.svg

# Python cache
__pycache__/
*.pyc
*.pyo

