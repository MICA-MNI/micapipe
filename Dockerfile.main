# ============================================================================
# MICAPIPE MAIN IMAGE - STAGE 2 (Fast, Frequently Changes)
# ============================================================================
# This Dockerfile creates the final micapipe image using the pre-built base
# Build this EVERY TIME the micapipe code changes
# Expected build time: 3-5 minutes (95% faster than full build!)
# ============================================================================

# Use the comprehensive base image we just built
# Replace with your actual registry/tag once base is pushed
ARG BASE_IMAGE=ghcr.io/mica-mni/micapipe-comprehensive-base:latest
FROM ${BASE_IMAGE}

USER root

ARG DEBIAN_FRONTEND="noninteractive"

# Label the image
LABEL maintainer="MICA Lab <mica.lab@mcgill.ca>" \
      description="MICApipe - Micapipe for multimodal MRI processing and analysis" \
      version="0.2.3"

# ============================================================================
# MICAPIPE CODE & CONFIGURATION
# ============================================================================

# Copy micapipe source code
COPY . /opt/micapipe/

# Set permissions
RUN chmod +x /opt/micapipe/micapipe \
    && chmod -R a+rx /opt/micapipe

# ============================================================================
# INTEGRATE MICAPIPE WITH INSTALLED TOOLS
# ============================================================================

# Move fix settings and FSL configuration files
RUN bash -c 'cd /opt/micapipe && \
    mv fix_settings.sh /opt/fix1.068/settings.sh && \
    mv fsl_conf/* /opt/fsl-6.0.2/etc/flirtsch/'

# Copy fsaverage5 surface to FreeSurfer
RUN bash -c 'cp -r /opt/micapipe/surfaces/fsaverage5 /opt/freesurfer-7.4.1/subjects'

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================

ENV MICAPIPE="/opt/micapipe"
ENV PROC="container_micapipe-v0.2.3"
ENV PATH="/opt/micapipe/:/opt/micapipe/functions:${PATH}"

# ============================================================================
# ENTRYPOINT
# ============================================================================

WORKDIR /home/mica

# Set micapipe as the entrypoint
# Note: Base image handles environment activation via BASH_ENV
ENTRYPOINT ["/opt/micapipe/micapipe"]

# ============================================================================
# IMAGE BUILD COMPLETE
# ============================================================================
# This lightweight image contains only micapipe code on top of the base
# Rebuilds are fast since all heavy tools are in the base layer
# ============================================================================
