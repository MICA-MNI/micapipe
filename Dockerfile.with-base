# ============================================================================
# MICAPIPE DOCKERFILE USING PRE-BUILT MAMBA BASE IMAGE
# Dramatically faster builds by reusing pre-built mamba environments
# ============================================================================

# Use our pre-built mamba environment base image
FROM ghcr.io/mica-mni/micapipe-mamba-base:v1.0

USER root
ARG DEBIAN_FRONTEND="noninteractive"
ENV APT_LISTCHANGES_FRONTEND=none
ENV APT_OPTIONS="-o APT::Install-Suggests=false -o APT::Install-Recommends=false"

# CUDA build argument - defaults to false to preserve current behavior
ARG ENABLE_CUDA=false
ARG MICAPIPE_CACHE_DIR=""
ARG DOWNLOADS_DIR="/downloads"
ARG CUSTOM_TMPDIR="/host/cassio/export03/data/enning"

# Copy downloaded dependencies if available
COPY . /tmp/build_context/
RUN mkdir -p /downloads && \
    echo "Copying pre-downloaded files if available..." && \
    if [ -f "/tmp/build_context/fsl-6.0.2-centos6_64.tar.gz" ]; then \
        echo "✅ Copying FSL..."; \
        cp /tmp/build_context/fsl-6.0.2-centos6_64.tar.gz /downloads/; \
    else \
        echo "⚠️  FSL not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz" ]; then \
        echo "✅ Copying FreeSurfer..."; \
        cp /tmp/build_context/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz /downloads/; \
    else \
        echo "⚠️  FreeSurfer not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/linux_openmp_64.tgz" ]; then \
        echo "✅ Copying AFNI..."; \
        cp /tmp/build_context/linux_openmp_64.tgz /downloads/; \
    else \
        echo "⚠️  AFNI not found, will download during build"; \
    fi && \
    if [ -f "/tmp/build_context/fix.tar.gz" ]; then \
        echo "✅ Copying FSL FIX..."; \
        cp /tmp/build_context/fix.tar.gz /downloads/; \
    else \
        echo "⚠️  FSL FIX not found, will download during build"; \
    fi && \
    rm -rf /tmp/build_context

# Install remaining system packages needed for neuroimaging tools
RUN echo "Installing neuroimaging system dependencies..." && \
    apt-get update && apt-get install -y --no-install-recommends \
        apt-utils \
        bc \
        build-essential \
        dc \
        file \
        gnupg \
        libgfortran3 \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libglu1-mesa \
        libgomp1 \
        libgtk-3-0 \
        liblapack3 \
        libopenblas-base \
        libquadmath0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxt6 \
        lsb-release \
        make \
        pkg-config \
        python3 \
        python3-pip \
        software-properties-common \
        tcsh \
        unzip \
        x11-apps \
        xvfb \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up conda paths (already configured in base image)
ENV PATH="/opt/miniconda-latest/bin:$PATH"

# ============================================================================
# NEUROIMAGING TOOLS INSTALLATION
# (Much faster now - no mamba package resolution!)
# ============================================================================

# Install FSL with caching support
ENV FSLDIR="/opt/fsl-6.0.2" \
    PATH="/opt/fsl-6.0.2/bin:$PATH" \
    FSLOUTPUTTYPE="NIFTI_GZ" \
    FSLMULTIFILEQUIT="TRUE" \
    FSLTCLSH="/opt/fsl-6.0.2/bin/fsltclsh" \
    FSLWISH="/opt/fsl-6.0.2/bin/fslwish" \
    FSLLOCKDIR="" \
    FSLMACHINELIST="" \
    FSLREMOTECALL=""

RUN echo "Installing FSL..." \
    && FSL_CACHE="${MICAPIPE_CACHE_DIR}/fsl-6.0.2-centos6_64.tar.gz" \
    && FSL_DOWNLOAD="/downloads/fsl-6.0.2-centos6_64.tar.gz" \
    && if [ ! -z "${MICAPIPE_CACHE_DIR}" ] && [ -f "$FSL_CACHE" ]; then \
        echo "📦 Using cached FSL from $FSL_CACHE ($(du -h "$FSL_CACHE" | cut -f1))"; \
        cp "$FSL_CACHE" /tmp/fsl.tar.gz; \
    elif [ -f "$FSL_DOWNLOAD" ]; then \
        echo "📦 Using pre-downloaded FSL from $FSL_DOWNLOAD ($(du -h "$FSL_DOWNLOAD" | cut -f1))"; \
        cp "$FSL_DOWNLOAD" /tmp/fsl.tar.gz; \
    else \
        echo "📥 Downloading FSL from internet..."; \
        curl -fL https://fsl.fmrib.ox.ac.uk/fsldownloads/fsl-6.0.2-centos6_64.tar.gz -o /tmp/fsl.tar.gz; \
        if [ ! -z "${MICAPIPE_CACHE_DIR}" ]; then \
            mkdir -p "${MICAPIPE_CACHE_DIR}" && cp /tmp/fsl.tar.gz "${MICAPIPE_CACHE_DIR}/fsl-6.0.2-centos6_64.tar.gz"; \
        fi; \
    fi \
    && tar -xf /tmp/fsl.tar.gz -C /opt \
    && rm /tmp/fsl.tar.gz \
    && echo "Running FSL Python installer..." \
    && ${FSLDIR}/etc/fslconf/fslpython_install.sh -f ${FSLDIR}

# Install FreeSurfer
ENV FREESURFER_HOME="/opt/freesurfer" \
    SUBJECTS_DIR="/opt/freesurfer/subjects" \
    FUNCTIONALS_DIR="/opt/freesurfer/sessions" \
    MNI_DIR="/opt/freesurfer/mni" \
    LOCAL_DIR="/opt/freesurfer/local" \
    MINC_BIN_DIR="/opt/freesurfer/mni/bin" \
    MINC_LIB_DIR="/opt/freesurfer/mni/lib" \
    MNI_DATAPATH="/opt/freesurfer/mni/data"
ENV PERL5LIB="/opt/freesurfer/mni/lib/perl5/5.8.5" \
    MNI_PERL5LIB="/opt/freesurfer/mni/lib/perl5/5.8.5" \
    PATH="/opt/freesurfer/bin:/opt/freesurfer/fsfast/bin:/opt/freesurfer/tktools:/opt/freesurfer/mni/bin:$PATH"

RUN echo "Installing FreeSurfer..." \
    && FREESURFER_CACHE="${MICAPIPE_CACHE_DIR}/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz" \
    && FREESURFER_DOWNLOAD="/downloads/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz" \
    && if [ ! -z "${MICAPIPE_CACHE_DIR}" ] && [ -f "$FREESURFER_CACHE" ]; then \
        echo "📦 Using cached FreeSurfer from $FREESURFER_CACHE ($(du -h "$FREESURFER_CACHE" | cut -f1))"; \
        cp "$FREESURFER_CACHE" /tmp/freesurfer.tar.gz; \
    elif [ -f "$FREESURFER_DOWNLOAD" ]; then \
        echo "📦 Using pre-downloaded FreeSurfer from $FREESURFER_DOWNLOAD ($(du -h "$FREESURFER_DOWNLOAD" | cut -f1))"; \
        cp "$FREESURFER_DOWNLOAD" /tmp/freesurfer.tar.gz; \
    else \
        echo "📥 Downloading FreeSurfer from internet..."; \
        curl -fL https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/7.4.1/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz -o /tmp/freesurfer.tar.gz; \
        if [ ! -z "${MICAPIPE_CACHE_DIR}" ]; then \
            mkdir -p "${MICAPIPE_CACHE_DIR}" && cp /tmp/freesurfer.tar.gz "${MICAPIPE_CACHE_DIR}/freesurfer-linux-ubuntu18_amd64-7.4.1.tar.gz"; \
        fi; \
    fi \
    && tar -xf /tmp/freesurfer.tar.gz -C /opt \
    && rm /tmp/freesurfer.tar.gz

# Install AFNI
ENV PATH="/opt/afni:$PATH" \
    AFNI_PLUGINPATH="/opt/afni"

RUN echo "Installing AFNI..." \
    && mkdir -p /opt/afni \
    && if [ -f "/downloads/linux_openmp_64.tgz" ]; then \
    echo "Installing AFNI from pre-downloaded file..." \
    && tar -xf /downloads/linux_openmp_64.tgz -C /opt/afni --strip-components=1; \
    else \
        echo "Pre-downloaded AFNI not found, downloading from internet..."; \
        curl -fL https://afni.nimh.nih.gov/pub/dist/tgz/linux_openmp_64.tgz \
            | tar -xz -C /opt/afni --strip-components=1; \
    fi

# Copy ANTs v2.3.4 binaries from kaczmarj/ants:2.3.4
COPY --from=kaczmarj/ants:2.3.4 /opt/ants /opt/ants-2.3.4
ENV ANTSPATH="/opt/ants-2.3.4/bin" \
    PATH="/opt/ants-2.3.4/bin:$PATH"

# Install FSL FIX
RUN echo "Installing FSL FIX..." \
    && mkdir -p /opt/fix \
    && if [ -f "/downloads/fix.tar.gz" ]; then \
        echo "Installing FSL FIX from pre-downloaded file..."; \
        tar -xf /downloads/fix.tar.gz -C /opt/fix --strip-components=1; \
    else \
        echo "Pre-downloaded FSL FIX not found, downloading from internet..."; \
        curl -fL https://www.fmrib.ox.ac.uk/~steve/ftp/fix.tar.gz \
            | tar -xz -C /opt/fix --strip-components=1; \
    fi
ENV PATH="/opt/fix:$PATH"

# Install remaining packages via pip (much faster than conda for these)
RUN echo "Installing remaining Python packages via pip..." \
    && . /opt/miniconda-latest/etc/profile.d/conda.sh \
    && conda activate micapipe \
    && pip install --no-cache-dir \
        vtk \
        pyvista \
        fury==0.8.0

# Install Git repositories (LAMAReg, ENIGMA, etc.)
RUN echo "Installing LAMAReg and ENIGMA from GitHub..." \
    && . /opt/miniconda-latest/etc/profile.d/conda.sh \
    && conda activate micapipe \
    && echo "Installing LAMAReg..." \
    && pip install --no-cache-dir git+https://github.com/MICA-MNI/LAMAReg.git \
    && echo "Installing ENIGMA..." \
    && pip install --no-cache-dir git+https://github.com/MICA-MNI/ENIGMA.git

# Set up workspace and final configurations
WORKDIR /opt/micapipe
COPY . /opt/micapipe/

# Final environment setup
RUN echo ". /opt/miniconda-latest/etc/profile.d/conda.sh" >> ~/.bashrc \
    && echo "conda activate micapipe" >> ~/.bashrc

ENV BASH_ENV="/opt/miniconda-latest/etc/profile.d/conda.sh"

# Metadata
LABEL org.opencontainers.image.title="MICApipe"
LABEL org.opencontainers.image.description="MICApipe neuroimaging analysis pipeline"
LABEL org.opencontainers.image.source="https://github.com/MICA-MNI/micapipe"
LABEL org.opencontainers.image.documentation="https://micapipe.readthedocs.io/"

# Entry point
CMD ["/bin/bash"]